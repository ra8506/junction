{
  "name": "junction",
  "version": "0.1.0",
  "description": "Unified email, calendar and messaging desktop app for Windows",
  "main": "out/main/index.js",
  "author": "Brian",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "npm run ensure-electron",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "predev": "npm run ensure-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "imapflow": "^2.10.2",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1",
    "tsdav": "^2.5.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.junction.desktop",
    "productName": "Junction",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
